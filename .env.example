APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=graphrag_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_GENERATOR=placeholder
# AI_TIMEOUT bounds the gRPC generation call (opt-in local-llm fallback only).
# AI_RETRIEVAL_TIMEOUT bounds the gRPC retrieval call, which is fast now — 45s
# clears a cold first inference yet surfaces a hang in under a minute.
AI_TIMEOUT=30
AI_RETRIEVAL_TIMEOUT=45
AI_RETRIEVAL_URL=
AI_GENERATION_URL=

# OpenAI-compatible generation driver (set AI_GENERATOR=openai_compatible to use
# it). Retrieval stays gRPC; only generation moves to a hosted /chat/completions
# endpoint. Provider-neutral names — switching providers is an env change. The
# default AI_GENERATOR above is intentionally left as-is; flip it only once
# LLM_API_KEY is set. NOTE: confirm LLM_MODEL is on the provider's free tier and
# served at LLM_BASE_URL (check the provider console — it can't be verified from
# this repo) before relying on it as the default.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
LLM_MAX_TOKENS=1024
# Whole-request cap for the hosted stream (cURL CURLOPT_TIMEOUT): first token in
# ~1-2s, full answer well under 30s, so 30s bounds a stalled stream in a minute.
LLM_TIMEOUT=30

# --- Research agent (escalation path) --------------------------------------
# The multi-hop agent runs as its own Node process (agent/src/server.ts) and the
# app reaches it over HTTP. It stays TypeScript on purpose: the hand-written loop
# is the artefact. Start it with `docker compose --profile agent up -d`.
#
# The app offers the "Продлабочи го истражувањето" control only when BOTH
# AGENT_SERVICE_URL and AGENT_SERVICE_TOKEN are set; otherwise no button appears.
#
# AGENT_API_TOKEN is a Sanctum personal access token the agent uses to call this
# app's own tool endpoints. Mint one:
#   php artisan tinker --execute 'echo App\Models\User::first()->createToken("agent")->plainTextToken;'
AGENT_SERVICE_URL=http://agent:5060
AGENT_SERVICE_TOKEN=
AGENT_SERVICE_TIMEOUT=120
AGENT_API_TOKEN=
AGENT_MAX_STEPS=8

# One daily meter for both answer paths, in units. A pipeline answer costs 1; an
# agent escalation costs 4, measured at a mean 4.3x the tokens (8,964-25,397
# across runs, vs 4,628 for one pipeline call). 60 units is ~60 ordinary
# questions or ~15 escalations. Set to 0 to disable.
GENERATION_DAILY_UNITS=60
GENERATION_PIPELINE_COST=1
GENERATION_ESCALATION_COST=4

# docker-compose only. The generator must be multilingual for the Macedonian
# legal corpus; the embedder must match the model the vector store was built
# with (BGE-M3 — see its meta table) or the cosine scores are meaningless.
GENERATION_MODEL_PATH=Qwen/Qwen2.5-1.5B-Instruct
GENERATION_MODEL_NAME=qwen2.5-1.5b-instruct
GENERATION_PROMPT_STYLE=chat
EMBED_MODEL_PATH=BAAI/bge-m3
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
# The cross-encoder reranker is removed (RERANK_BACKEND=none): nothing reranks,
# and RETRIEVAL_TOP_N passages are returned from the RRF-fused pool in rank order.
# Keep CANDIDATE_POOL >= RETRIEVAL_TOP_N. RERANK_TOP_N is the deprecated alias for
# RETRIEVAL_TOP_N. See docker-compose.yml / config.py for the measured trade.
RERANK_BACKEND=none
CANDIDATE_POOL=24
RETRIEVAL_TOP_N=10

# Include every origin the SPA is served from (Herd .test domain, artisan serve,
# Vite). Requests whose Origin/Referer host is not listed are treated as
# third-party and get no session — which breaks cookie-based login/register.
SANCTUM_STATEFUL_DOMAINS=graphrag-app.test,localhost:8000,127.0.0.1:8000

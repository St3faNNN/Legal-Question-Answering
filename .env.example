# =============================================================================
# GraphRAG for Macedonian Legislation — environment
# =============================================================================
# Every variable this project reads is listed here, grouped, with a one-line
# comment and the default that applies when it is unset. A commented-out line
# means "the default in config/ is in effect"; uncomment to override.
#
# SECRETS have no default and appear as empty placeholders. They are empty on
# purpose: a secret that falls back to a placeholder fails at the provider with
# a 401 that reads like an outage, instead of failing here with the name of the
# variable you forgot. Never commit a real value to this file.
#
# Variables consumed by other processes (the Node agent, the Python retrieval
# and generation services) are marked with the runtime that reads them.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local                              # local | production | testing
# SECRET. Encrypts sessions and cookies. Generate: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true                             # never true in production
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file                # file | cache

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14                        # retention for the daily channel
# AI_LOG_DAYS=14                           # retention for the "ai" channel.
                                           # NOTE: storage/ is not mounted into
                                           # the app containers, so these files
                                           # do NOT survive a container recreate.
                                           # The admin dashboard reads the
                                           # database, never these logs.

# --- Database ----------------------------------------------------------------
# POSTGRES_* are read by BOTH the postgres service (at first volume init) and
# the app (as DB_USERNAME/DB_DATABASE/DB_PASSWORD) in docker-compose, so the two
# cannot drift apart.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                          # "postgres" inside docker-compose
DB_PORT=5432
POSTGRES_DB=graphrag_app
POSTGRES_USER=graphrag
# SECRET. docker-compose REFUSES TO START until this is set — there is
# deliberately no committed fallback, because this file is in git.
# Rotating it after the volume exists needs an ALTER ROLE; see README.
POSTGRES_PASSWORD=
# Non-Docker (Herd) runs read these directly instead of the POSTGRES_* pair.
DB_DATABASE=graphrag_app
DB_USERNAME=graphrag
# SECRET.
DB_PASSWORD=
# DB_QUEUE_RETRY_AFTER=360                 # seconds before the queue re-reserves
                                           # a job. MUST exceed the longest job
                                           # (~300s on the grpc fallback) or a
                                           # running job is handed to a second
                                           # worker and answered twice.

# --- Session / cache / queue / filesystem ------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Comma-separated origins treated as first-party for cookie auth.
# SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# --- Redis (streaming side channel) ------------------------------------------
REDIS_CLIENT=phpredis                      # "predis" in docker-compose (pure PHP)
REDIS_HOST=127.0.0.1                       # "redis" inside docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=null                        # SECRET when the instance requires one

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null                         # SECRET when a real mailer is used
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Retrieval (Laravel -> gRPC service) -------------------------------------
AI_RETRIEVAL_TIMEOUT=45                    # gRPC retrieval call deadline
# gRPC target, host:port with no scheme. NO DEFAULT: only docker-compose knows
# this hostname and it resolves only on its network, so an absent value fails at
# resolve-time naming the variable rather than dialling a null host.
AI_RETRIEVAL_URL=
# How many passages retrieval returns AND how many the provisions panel shows —
# one value read by two processes, so the panel can never be shorter than the
# generation context.
RETRIEVAL_TOP_N=10
# LEGAL_PROMPT_PATH=prompts/legal_mk.txt   # shared MK system prompt

# --- Generation (hosted, the ONLY backend) -----------------------------------
# Local generation was removed: running a 3B model beside retrieval is not
# viable on a t3.medium. There is no offline mode and no placeholder driver, so
# A GEMINI KEY IS REQUIRED FOR LOCAL DEVELOPMENT — without it the app refuses to
# build the generation client and every question fails loudly, by design.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SECRET. No default. Missing => RuntimeException naming this variable.
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30                             # whole-request cap, streaming included

# --- SSE relay idle budgets ---------------------------------------------------
# CHAT_STREAM_FIRST_CHUNK_TIMEOUT=30       # silence tolerated before the first
                                           # token (retrieval + prefill)
# CHAT_STREAM_BETWEEN_CHUNK_TIMEOUT=12     # silence tolerated once tokens flow
# CHAT_STREAM_POLL_SECONDS=5               # blpop block length / keepalive cadence
# CHAT_STREAM_KEY_TTL=300                  # how long a stream stays attachable

# --- Research agent (escalation path) ----------------------------------------
# The agent runs as its own Node process; start it with
#   docker compose --profile agent up -d
# The app offers the escalation control only when URL and TOKEN are both set.
AGENT_SERVICE_URL=http://agent:5060
# SECRET. Shared bearer between the app and the agent service.
AGENT_SERVICE_TOKEN=
# SECRET. Sanctum token the agent uses to call this app's own tool endpoints:
#   php artisan tinker --execute 'echo App\Models\User::first()->createToken("agent")->plainTextToken;'
AGENT_API_TOKEN=
AGENT_SERVICE_TIMEOUT=120                  # whole-run cap
AGENT_MAX_STEPS=8                          # step budget per run
# AGENT_SERVICE_CONNECT_TIMEOUT=5          # connection open, apart from the run
# AGENT_APP_URL=http://localhost:8000      # [agent] where its tools live
# AGENT_SERVICE_PORT=5060                  # [agent] listen port. 5060 is SIP
                                           # and is on the WHATWG Fetch blocked-
                                           # ports list, so Node's fetch refuses
                                           # this URL with "bad port". cURL (and
                                           # so the app) is unaffected; a Node
                                           # client would need another port.
# AGENT_LLM_TIMEOUT_MS=60000               # [agent] per model call
# AGENT_TOOL_TIMEOUT_MS=60000              # [agent] per tool call
# AGENT_COMPACT_HISTORY=1                  # [agent] compress older tool results
# AGENT_SESSION_TTL_HOURS=72               # [agent] CLI session expiry
# AGENT_MEMORY_NOTE=                       # [agent] experimental, off by default
# INSPECTOR_PORT=5055                      # [agent] trace inspector

# --- Generation budget (one meter, both answer paths) ------------------------
GENERATION_DAILY_UNITS=60                  # units/user/day; 0 disables the meter
GENERATION_PIPELINE_COST=1                 # measured 4,628 tokens
GENERATION_ESCALATION_COST=4               # measured a mean 4.3x the pipeline

# --- Rate limits (requests per minute) ---------------------------------------
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_CHAT=30
# RATE_LIMIT_ESCALATE=5                    # tighter: a run is ~4x the tokens
# RATE_LIMIT_TOOLS=60                      # agent tool endpoints (retrieval only)

# --- Page sizes ---------------------------------------------------------------
# PER_PAGE_MESSAGES=20
# PER_PAGE_CONVERSATIONS=15
# PER_PAGE_TODO_LISTS=15
# PER_PAGE_ADMIN_EXCHANGES=30

# --- Operational dashboard ----------------------------------------------------
# Comma-separated email allowlist. NO DEFAULT and no fallback: empty means
# NOBODY, and every /api/v1/admin route 404s. A typo locks the panel rather than
# opening it. The panel can read conversation content — see privacy notice §9.
ADMIN_EMAILS=
# ADMIN_METRICS_WINDOW_DAYS=90             # aggregation window
# ADMIN_LATENCY_BUCKETS_MS=250,500,1000,2000,5000,10000,30000,60000,120000

# --- Retrieval service (Python, docker-compose) ------------------------------
# [retrieval] Tuning for the BGE-M3 hybrid retriever. All optional.
# CANDIDATE_POOL=24                        # RRF pool size — the only ranking
                                           # stage; must be >= RETRIEVAL_TOP_N
# CONTEXT_CHAR_BUDGET=12000                # chars packed into the generation context
# EMBED_MODEL_PATH=BAAI/bge-m3
# RETRIEVAL_QUANTIZE=int8                  # int8 | none. Embedder only now; kept
                                           # for continuity with captured eval runs,
                                           # not a measured win (no VNNI on this CPU)
# RETRIEVAL_MODEL_DTYPE=float32            # bfloat16 is emulated (and glacial) on
                                           # a CPU without AMX — leave float32
# DENSE_TOP_K=                             # dense candidates before fusion
# SPARSE_TOP_K=                            # sparse candidates before fusion
# USE_SPARSE=                              # enable the sparse arm
# RRF_K=                                   # reciprocal-rank-fusion constant
# GRAPH_HOPS=                              # citation-graph expansion depth
# GRAPH_MAX_EXPAND=                        # cap on expanded nodes
# GRAPH_PATH=/data/graph.graphml           # set by docker-compose
# VECTOR_DB_PATH=/vectors/vectors.sqlite   # set by docker-compose
# DEVICE=                                  # cpu | cuda
# PORT=8001                                # gRPC listen port
# GRPC_MAX_WORKERS=                        # gRPC thread pool
# INJECTION_FIXTURE_PATH=                  # prompt-injection TEST overlay; empty = off

# --- AWS (unused; kept for the framework's filesystem config) ----------------
AWS_ACCESS_KEY_ID=                         # SECRET
AWS_SECRET_ACCESS_KEY=                     # SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
